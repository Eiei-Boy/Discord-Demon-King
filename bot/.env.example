# Discord Bot Token - Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Client ID - Your bot's application ID
CLIENT_ID=your_client_id_here

# Guild ID - For development (optional, for guild-specific commands)
GUILD_ID=your_guild_id_here

# Backend API URL - For contract storage (default: http://localhost:8000/api/v1/contract)
API_BASE_URL=http://localhost:8000/api/v1/contract
